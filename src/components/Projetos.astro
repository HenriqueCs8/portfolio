---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import { site, dois } from '../lib/site';

interface Props {
  projetos: CollectionEntry<'projetos'>[];
  nomes: Map<string, string>;
}
const { projetos, nomes } = Astro.props;
const porPagina = site.projetosPorPagina;
const paginas = Math.ceil(projetos.length / porPagina);
const lista = await Promise.all(projetos.map(async (p) => ({ p, Content: (await render(p)).Content })));

// texto no lugar do link; o .md pode trocar com semLink
const semLinkPadrao: Record<string, string> = {
  Comercial: 'Entregue ao cliente, sem link público.',
  Pessoal: 'Projeto pessoal, sem link público.',
  Estudo: 'Projeto de estudo, sem link público.',
};
---

<section class="sec projetos" id="projetos" data-secao="projetos">
  <header class="sec-cab" data-rev>
    <h2 class="t-sec" data-titulo><span class="ln"><span>Projetos</span></span></h2>
    <p class="sec-nota" data-acende>Sites para clientes e projetos pessoais, feitos do zero por mim. Os sistemas internos que criei na AGX estão na <a class="lk" href="#carreira">Carreira</a>.</p>
  </header>

  <ol class="proj-lista" data-rev data-paginas={paginas}>
    {projetos.map((p, i) => (
      <li class="proj" id={`projeto-${p.id}`} data-projeto={p.id} data-pagina={Math.floor(i / porPagina)} style={`--i:${i % porPagina}`}>
        <Image class="proj-mini" data-vel src={p.data.imagem} alt="" widths={[280, 560, 800]} sizes="(max-width: 860px) 92vw, 140px" />
        <div class="proj-meio">
          <h3 class="proj-tit" data-rola>{p.data.titulo}</h3>
          <p class="proj-res">{p.data.resumo}</p>
        </div>
        <p class="proj-meta"><span>{p.data.tipo}</span><span>{p.data.quando}</span></p>
        <button class="bt proj-bt" data-rola type="button" aria-haspopup="dialog">Ver detalhes<span class="so-leitor">: {p.data.titulo}</span></button>
      </li>
    ))}
  </ol>

  {paginas > 1 && (
    <nav class="pager" aria-label="Páginas de projetos" hidden>
      <p class="pager-onde" aria-hidden="true"><span class="pager-n" data-pag-n>01</span> / {dois(paginas)}</p>
      <p class="so-leitor" aria-live="polite" data-pag-status></p>
      <div class="pager-bts">
        <button class="seta" type="button" data-pag="-1" aria-label="Projetos anteriores">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
        </button>
        <button class="seta" type="button" data-pag="1" aria-label="Próximos projetos">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </nav>
  )}

  <div class="previa" aria-hidden="true">
    {projetos.map((p) => <Image src={p.data.imagem} alt="" data-previa={p.id} widths={[560, 1120]} sizes="540px" />)}
  </div>
</section>

<dialog class="det" id="detalhe">
  <div class="det-fundo"></div>
  <div class="det-rolo" data-lenis-prevent>
    <div class="det-barra">
      <p class="det-cont" aria-live="polite">
        <span class="so-leitor" data-det-n-leitor>Projeto 1 de {projetos.length}</span>
        <span aria-hidden="true">Projeto <span class="odo"><span class="odo-trilho" data-det-odo>{projetos.map((_, i) => <span>{dois(i + 1)}</span>)}</span></span> de {dois(projetos.length)}</span>
      </p>
      <button class="bt det-fecha" data-rola type="button">Fechar</button>
    </div>
    {lista.map(({ p, Content }) => (
      <article class="det-art" data-det={p.id} hidden>
        <header class="det-cab">
          {/* ao abrir, o foco vai para o título */}
          <h2 class="det-tit" id={`det-tit-${p.id}`} tabindex="-1"><span class="so-leitor">{p.data.titulo}</span><span class="det-tit-v" aria-hidden="true">{p.data.titulo}</span></h2>
          <div class="det-fatos det-anim">
            <dl class="det-dados">
              <div><dt>Tipo</dt><dd>{p.data.tipo}</dd></div>
              <div><dt>Quando</dt><dd>{p.data.quando}</dd></div>
            </dl>
            {!p.data.link && <p class="det-sem">{p.data.semLink ?? semLinkPadrao[p.data.tipo]}</p>}
            {(p.data.link || p.data.codigo) && (
              <div class="det-acoes">
                {p.data.link && (
                  <a class="bt bt-cheio" data-rola href={p.data.link} target="_blank" rel="noopener">Abrir site<span class="so-leitor"> (abre em nova aba)</span></a>
                )}
                {p.data.codigo && (
                  <a class="bt bt-icone" href={p.data.codigo} target="_blank" rel="noopener">
                    <!-- Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc. -->
                    <svg viewBox="0 0 496 512" aria-hidden="true" focusable="false"><path fill="currentColor" d="M165.9 397.4c0 2-2.3 3.6-5.2 3.6-3.3.3-5.6-1.3-5.6-3.6 0-2 2.3-3.6 5.2-3.6 3-.3 5.6 1.3 5.6 3.6zm-31.1-4.5c-.7 2 1.3 4.3 4.3 4.9 2.6 1 5.6 0 6.2-2s-1.3-4.3-4.3-5.2c-2.6-.7-5.5.3-6.2 2.3zm44.2-1.7c-2.9.7-4.9 2.6-4.6 4.9.3 2 2.9 3.3 5.9 2.6 2.9-.7 4.9-2.6 4.6-4.6-.3-1.9-3-3.2-5.9-2.9zM244.8 8C106.1 8 0 113.3 0 252c0 110.9 69.8 205.8 169.5 239.2 12.8 2.3 17.3-5.6 17.3-12.1 0-6.2-.3-40.4-.3-61.4 0 0-70 15-84.7-29.8 0 0-11.4-29.1-27.8-36.6 0 0-22.9-15.7 1.6-15.4 0 0 24.9 2 38.6 25.8 21.9 38.6 58.6 27.5 72.9 20.9 2.3-16 8.8-27.1 16-33.7-55.9-6.2-112.3-14.3-112.3-110.5 0-27.5 7.6-41.3 23.6-58.9-2.6-6.5-11.1-33.3 2.6-67.9 20.9-6.5 69 27 69 27 20-5.6 41.5-8.5 62.8-8.5s42.8 2.9 62.8 8.5c0 0 48.1-33.6 69-27 13.7 34.7 5.2 61.4 2.6 67.9 16 17.7 25.8 31.5 25.8 58.9 0 96.5-58.9 104.2-114.8 110.5 9.2 7.9 17 22.9 17 46.4 0 33.7-.3 75.4-.3 83.6 0 6.5 4.6 14.4 17.3 12.1C428.2 457.8 496 362.9 496 252 496 113.3 383.5 8 244.8 8zM97.2 352.9c-1.3 1-1 3.3.7 5.2 1.6 1.6 3.9 2.3 5.2 1 1.3-1 1-3.3-.7-5.2-1.6-1.6-3.9-2.3-5.2-1zm-10.8-8.1c-.7 1.3.3 2.9 2.3 3.9 1.6 1 3.6.7 4.3-.7.7-1.3-.3-2.9-2.3-3.9-2-.6-3.6-.3-4.3.7zm32.4 35.6c-1.6 1.3-1 4.3 1.3 6.2 2.3 2.3 5.2 2.6 6.5 1 1.3-1.3.7-4.3-1.3-6.2-2.2-2.3-5.2-2.6-6.5-1zm-11.4-14.7c-1.6 1-1.6 3.6 0 5.9 1.6 2.3 4.3 3.3 5.6 2.3 1.6-1.3 1.6-3.9 0-6.2-1.4-2.3-4-3.3-5.6-2z" /></svg>
                    <span data-rola>Ver código</span><span class="so-leitor"> no GitHub (abre em nova aba)</span>
                  </a>
                )}
              </div>
            )}
          </div>
        </header>
        <figure class="det-fig">
          <div class="det-moldura">
            <Image class="det-img" src={p.data.imagem} alt={`Tela do projeto ${p.data.titulo}`} widths={[960, 1400, 1840]} sizes="(max-width: 860px) 92vw, 62vw" />
          </div>
          {p.data.provisoria && <figcaption>Imagem provisória. O print real do projeto entra aqui.</figcaption>}
        </figure>
        <div class="det-grade">
          <div class="det-desc det-anim"><Content /></div>
          <div class="det-info det-anim">
            <h3 class="det-rot">Linguagens e ferramentas</h3>
            <ul class="tags">
              {[...p.data.stack.map((s) => nomes.get(s)!), ...p.data.extras].map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </div>
      </article>
    ))}
    <div class="det-nav">
      <button class="bt" data-rola type="button" data-det-ir="-1">Projeto anterior</button>
      <button class="bt" data-rola type="button" data-det-ir="1">Próximo projeto</button>
    </div>
  </div>
</dialog>
